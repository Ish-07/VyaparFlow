ENVIRONMENT=local

# Postgres
DATABASE_URL=postgresql+asyncpg://vyaparflow:vyaparflow@localhost:5432/vyaparflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Object storage (S3-compatible) - used from Step 4+ (voice audio, invoices)
OBJECT_STORAGE_BUCKET=vyaparflow-files
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# AI providers — Step 7: real LLM (NVIDIA NIM) as primary intent/entity
# parser, with the Step 6 rule-based regex parser as automatic fallback.
#
# Getting a free NVIDIA NIM API key:
#   1. Sign up at https://build.nvidia.com (free tier available)
#   2. Find any model page (e.g. meta/llama-3.3-70b-instruct) and generate an API key
#   3. Paste it as LLM_API_KEY below
#
# Recommended MVP/free setup: leave LLM_API_KEY blank during early local
# development — the app runs entirely on the rule-based fallback with
# zero AI config and zero cost. Add the key once you want real LLM
# parsing; nothing else needs to change.
#
# PRODUCTION WARNING: NVIDIA NIM's free tier is rate-limited and not
# meant to be treated as unlimited production infrastructure. For real
# production traffic, use a paid tier/quota appropriate to your volume,
# and keep ENABLE_RULE_BASED_AI_FALLBACK=true so a rate-limit or outage
# degrades gracefully instead of failing every command.
SPEECH_PROVIDER=openai
LLM_PROVIDER=nvidia_nim
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_COMMAND_MODEL=meta/llama-3.3-70b-instruct
LLM_AGENT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
TRANSLATION_MODEL=nvidia/riva-translate-4b-instruct-v1_1
AI_REQUEST_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=1
ENABLE_RULE_BASED_AI_FALLBACK=true

# Business rule defaults
COMMAND_CONFIDENCE_THRESHOLD=0.75
ALLOW_NEGATIVE_STOCK=false
AUDIO_RETENTION_DAYS=0
