ENVIRONMENT=local

# Postgres
DATABASE_URL=postgresql+asyncpg://vyaparflow:vyaparflow@localhost:5432/vyaparflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Object storage (S3-compatible) - used from Step 4+ (voice audio, invoices)
OBJECT_STORAGE_BUCKET=vyaparflow-files
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# AI provider configuration
# Gemini is used for command parsing, RAG responses, and embeddings.
#
# Create a Gemini API key at:
# https://aistudio.google.com/app/apikey
#
# Keep the key private. Use Replit Secrets or a local .env file.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

LLM_COMMAND_MODEL=gemini-3.6-flash
LLM_RAG_MODEL=gemini-3.6-flash
LLM_AGENT_MODEL=gemini-3.6-flash

EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536
TRANSLATION_MODEL=gemini-3.6-flash

AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
ENABLE_RULE_BASED_AI_FALLBACK=true

# Business rule defaults
COMMAND_CONFIDENCE_THRESHOLD=0.75
ALLOW_NEGATIVE_STOCK=false
AUDIO_RETENTION_DAYS=0
# OCR
OCR_PROVIDER=paddleocr
OCR_LANGUAGE=en
OCR_ENABLE_GPU=false