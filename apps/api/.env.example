ENVIRONMENT=local

# Postgres
DATABASE_URL=postgresql+asyncpg://vyaparflow:vyaparflow@localhost:5432/vyaparflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Object storage (S3-compatible) - used from Step 4+ (voice audio, invoices)
OBJECT_STORAGE_BUCKET=vyaparflow-files
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# AI providers - used from Step 5+ (NLP) and Step 8-9 (RAG/voice)
SPEECH_PROVIDER=openai
LLM_PROVIDER=openai
LLM_API_KEY=

# Business rule defaults
COMMAND_CONFIDENCE_THRESHOLD=0.75
ALLOW_NEGATIVE_STOCK=false
AUDIO_RETENTION_DAYS=0
